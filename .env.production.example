# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3002
API_PREFIX=api/v1
CORS_ORIGIN=https://ct095.com,https://www.ct095.com
APP_BASE_URL=https://www.ct095.com
API_PUBLIC_URL=https://api.ct095.com

# ─── Database (PostgreSQL na VPS; use porta dedicada se houver 2 bancos no mesmo host)
# Ex.: ct095-api em 5432, school_db em 5433
DATABASE_URL=postgresql://school:SENHA@localhost:5433/school_db?schema=public

# ─── Firebase Admin ────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── Mercado Pago ─────────────────────────────────────────────────────────────
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MP_SANDBOX=false
MP_DEV_SIMULATE=false

# ─── Cron ─────────────────────────────────────────────────────────────────────
CRON_SECRET=
