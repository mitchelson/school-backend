# Legado: prefira .env.development.example → .env.development.local
# Ver docs/DEVELOPMENT.md

NODE_ENV=development
PORT=3002
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3002

DATABASE_URL=postgresql://school:school@localhost:5432/school_db?schema=public

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

JWT_SECRET=change-me-must-be-at-least-32-characters-long
JWT_EXPIRATION=24h

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# OAuth marketplace — Client ID numérico da aplicação (NÃO use APP_USR- / Access Token)
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
# Deve ser idêntico à URL em “URLs de redirecionamento” no painel MP (sem barra final)
MERCADOPAGO_OAUTH_REDIRECT_URI=http://localhost:3002/api/v1/marketplace/mp/oauth/callback
# Padrão: auth.mercadopago.com.br (Brasil, sem seletor de país). Global só se necessário:
# MERCADOPAGO_OAUTH_AUTH_URL=https://auth.mercadopago.com/authorization
# Site MLB (Brasil) na URL de autorização — padrão MLB; use "none" para omitir
# MERCADOPAGO_OAUTH_SITE_ID=MLB

PLATFORM_TOTAL_FEE_PERCENT=7
PLATFORM_FEE_PERCENT=7
CREDIT_UNIT_PRICE_CENTS=3000
# Taxas MP (Pix/cartão): configuradas no painel Owner → Split (PlatformSetting)

MP_DEV_SIMULATE=true
MP_SANDBOX=true
PII_ENCRYPTION_KEY=
CRON_SECRET=change-me-cron-secret

# Better Stack (opcional — sem token = só stdout/PM2)
# BETTER_STACK_SOURCE_TOKEN=
# BETTER_STACK_LOGS_ENDPOINT=
# BETTER_STACK_SERVICE_NAME=school-api
