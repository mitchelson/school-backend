# VPS: copie para /opt/school-backend/.env.production
# ln -sf .env.production .env   (deploy/post-deploy.sh)

NODE_ENV=production
PORT=3002
API_PREFIX=api/v1
CORS_ORIGIN=https://ct095.com,https://www.ct095.com
APP_BASE_URL=https://www.ct095.com
API_PUBLIC_URL=https://api.ct095.com

DATABASE_URL=postgresql://school:SENHA@localhost:5433/school_db?schema=public

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Opcional se usar só Firebase; OAuth state usa o primeiro secret ≥32 chars disponível
JWT_SECRET=
JWT_EXPIRATION=24h
# Ou secret dedicado para assinar state do OAuth MP (recomendado em produção)
# MERCADOPAGO_OAUTH_STATE_SECRET=

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Client ID da aplicação MP (número) — não confundir com APP_USR- Access Token
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
# Copiar exatamente para “URLs de redirecionamento” em developers.mercadopago.com
MERCADOPAGO_OAUTH_REDIRECT_URI=https://api.ct095.com/api/v1/marketplace/mp/oauth/callback
# Auth Brasil (padrão) — login + “autorizar aplicativo”, sem tela de país
# MERCADOPAGO_OAUTH_AUTH_URL=https://auth.mercadopago.com.br/authorization
# MERCADOPAGO_OAUTH_SITE_ID=MLB
# PKCE: true se no painel MP estiver “authorization code + PKCE” (evita HTTP 400 na autorização)
MERCADOPAGO_OAUTH_PKCE=true
# Marketplace split — use "none" só se a aplicação não for marketplace
MERCADOPAGO_OAUTH_PLATFORM_ID=mp

PLATFORM_TOTAL_FEE_PERCENT=7
PLATFORM_FEE_PERCENT=7
CREDIT_UNIT_PRICE_CENTS=3000

MERCADOPAGO_STATEMENT_DESCRIPTOR=CT095
MP_ORDER_CATEGORY_ID=services
MP_SCHOOL_ZIP_CODE=
MP_SCHOOL_CITY=
MP_SCHOOL_STATE=
MP_SCHOOL_STREET=
MP_SCHOOL_STREET_NUMBER=

MP_DEV_SIMULATE=false
MP_SANDBOX=false
PII_ENCRYPTION_KEY=
CRON_SECRET=

# Email (Resend)
# RESEND_API_KEY=
# EMAIL_FROM=CT095 <noreply@seudominio.com>
# FRONTEND_URL=https://app.seudominio.com

# Better Stack Logs — source separado "CT095 School API" no painel
# BETTER_STACK_SOURCE_TOKEN=
# BETTER_STACK_LOGS_ENDPOINT=
# BETTER_STACK_SERVICE_NAME=school-api
