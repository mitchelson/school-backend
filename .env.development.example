# Copie para .env.development.local (recomendado) ou .env
# cp .env.development.example .env.development.local
#
# Variáveis sensíveis: Firebase Admin, Mercado Pago — use credenciais de TESTE.

NODE_ENV=development
# 3002 em dev — ct095-api costuma usar 3001 no mesmo host
PORT=3002
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3002

DATABASE_URL=postgresql://school:school@localhost:5432/school_db?schema=public

# Firebase Admin (mesmo projeto do frontend ou emulador)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

JWT_SECRET=dev-secret-must-be-at-least-32-characters-long
JWT_EXPIRATION=24h

# Mercado Pago — credenciais TEST do painel developers
MERCADOPAGO_ACCESS_TOKEN=TEST-xxx
MERCADOPAGO_WEBHOOK_SECRET=dev-webhook-secret
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_OAUTH_REDIRECT_URI=http://localhost:3002/api/v1/marketplace/mp/oauth/callback

PLATFORM_TOTAL_FEE_PERCENT=7
PLATFORM_FEE_PERCENT=7
MP_FEE_PERCENT_PIX=0.99
MP_FEE_PERCENT_CARD=4.98
MP_FEE_PERCENT_CARD_INSTALLMENTS=4.98
CREDIT_UNIT_PRICE_CENTS=3000

# true = simula Pix aprovado sem chamar MP (ideal para UI local)
MP_DEV_SIMULATE=true
MP_SANDBOX=true

PII_ENCRYPTION_KEY=dev-pii-key-at-least-32-chars-long!!
CRON_SECRET=dev-cron-secret
